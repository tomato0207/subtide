# Subtide 本機設定：只轉錄中文、不翻譯
HOST=127.0.0.1
PORT=5001

ENABLE_WHISPER=true
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=5

# 只轉錄，不呼叫任何 LLM，因此不需要 API key
TRANSCRIBE_ONLY=true

# OpenCC 簡轉繁（台灣用語）。留空則不轉換
CHINESE_CONVERSION=s2twp

# 不做說話者分離（需要 HF token 與 torch）
ENABLE_DIARIZATION=false
DIARIZATION_MODE=off
ENABLE_VAD=false
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# yt-dlp: 用 Node.js 解 YouTube JS challenge（需安裝 Node.js）
YTDLP_JS_RUNTIMES=node

# 章節摘要：用本機 Ollama 模型根據字幕產生（需安裝 Ollama 並下載模型）
SUMMARY_ENABLED=true
SUMMARY_MODEL=qwen2.5:7b
